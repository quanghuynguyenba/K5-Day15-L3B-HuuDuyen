# Chép thành .env rồi điền. KHÔNG commit .env.
# Để trống LLM_API_KEY (hoặc USE_MOCK=1) → toàn bộ app chạy bằng dữ liệu giả.
USE_MOCK=
LLM_API_KEY=
# Mã model, vd gpt-4o-mini, gemini-2.5-flash …
LLM_MODEL=
# Dùng SDK openai cho mọi nhà cung cấp có endpoint OpenAI-compatible.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   · OpenAI: để trống
LLM_BASE_URL=
GOONG_API_KEY=
# Chỉ cần nếu chọn phương án embedding B (API)
EMBED_API_KEY=
