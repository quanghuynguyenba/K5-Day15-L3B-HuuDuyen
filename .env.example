# Chép thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# Mỗi biến chỉ một dòng — trùng tên thì dòng có giá trị được dùng.

# --- Web app: server.py, agent/, routing/, services/ ---
# Để trống LLM_API_KEY (hoặc USE_MOCK=1) → agent dùng mock.
USE_MOCK=
LLM_API_KEY=
# Mã model, vd gpt-4o-mini, gemini-2.5-flash …
LLM_MODEL=
# Dùng SDK openai cho mọi nhà cung cấp có endpoint OpenAI-compatible.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   · OpenAI: để trống
LLM_BASE_URL=
# API key TomTom (Matrix Routing v2, Calculate Route) — chỉ backend dùng. Để trống = Haversine.
TOMTOM_API_KEY=
# USE_TOMTOM=0 để tắt TomTom dù có key
USE_TOMTOM=
# Thời tiết độc lập với LLM: real gọi Open-Meteo; mock chỉ dùng khi muốn demo dữ liệu giả.
WEATHER_MODE=real
# Chỉ cần nếu chọn phương án embedding B (API)
EMBED_API_KEY=

# --- Bộ chạy eval: python run.py (codebase/ai.py) ---
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
